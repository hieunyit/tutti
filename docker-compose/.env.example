# Copy to .env (next to docker-compose.yml) to customise the stack:  cp .env.example .env

# Password of the first console user "admin" (web UI at http://localhost:8080, management API).
# - Minimum 12 characters (maximum 72). A shorter value makes the worker refuse to start.
# - Leave EMPTY to let the worker generate a random one. It is printed ONCE on the worker's stderr:
#     docker compose logs worker | grep -A6 'INITIAL ADMIN PASSWORD'
# - Only used while the database has no console users (first start). To set a new password later:
#     docker compose exec worker /bin/tutti admin reset-password
# - The admin must change the password at first login (disable with TUTTI_BOOTSTRAP_ADMIN_FORCE_CHANGE=false).
TUTTI_BOOTSTRAP_ADMIN_PASSWORD=
